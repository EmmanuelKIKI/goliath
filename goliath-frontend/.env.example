# .env.example — je copie ce fichier en .env.local et je remplis mes
# vraies valeurs. Seules ces deux valeurs publiques sont nécessaires côté
# frontend : aucun secret Gemini, mot de passe interne ou code d'accès réel
# ne doit jamais se trouver dans le bundle JavaScript.

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
