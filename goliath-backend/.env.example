# Je ne mets JAMAIS mon vrai .env dans Git, il est déjà ignoré dans .gitignore.

# Connexion à ma base de données PostgreSQL
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL="postgresql://goliath_user:motdepasse@localhost:5432/goliath_db?schema=public"

# Port sur lequel mon serveur backend va tourner
PORT=4000

# Clé secrète utilisée pour signer mes tokens JWT (authentification)
# Je mets ici une longue chaîne aléatoire, jamais un mot simple
JWT_SECRET="je-remplace-cette-valeur-par-une-longue-chaine-secrete-et-aleatoire"

# Durée de validité de mon token de connexion
JWT_EXPIRES_IN="7d"

# URL autorisée à appeler mon API depuis le frontend (CORS)
# En local, c'est en général l'adresse de mon frontend Vite
FRONTEND_URL="http://localhost:5173"

# Environnement d'exécution : development ou production
NODE_ENV=development
